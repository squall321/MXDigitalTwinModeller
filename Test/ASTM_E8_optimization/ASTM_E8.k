$#$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$#		Writing Boundary Conditions		
$#$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$#
$BOUNDARY CONDITIONS                                                            
$
$
$==========================================================================
$  LS-DYNA Implicit Eigenvalue (Modal) Analysis Control Cards
$  Generated by MX Digital Twin Modeller
$==========================================================================
$
$--- Switch to implicit, eigenvalue mode ---
$
*CONTROL_IMPLICIT_GENERAL
$#  imflag       dt0    imform      nsbs       igs     cnstn      form    zero_v
         1       0.0         2         1         0         0         0         0
$
$--- Eigenvalue extraction parameters ---
$  NEIG    : Number of eigenvalues to extract
$  LFLAG=2 : Lower bound in frequency (Hz), 0=none
$  RFLAG=2 : Upper bound in frequency (Hz), 0=none
$  EIGMTH  : 2=Lanczos, 3=Inverse Power, 101=BCSLIB-EXT
$
*CONTROL_IMPLICIT_EIGENVALUE
$#    neig    center     lflag    lftend     rflag    rhtend    eigmth    shfscl
        10       0.0         0       0.0         0       0.0         2       0.0
$
$--- Implicit solver selection ---
$  LSOLVR : 2=Multi-frontal Sparse, 4=PARDISO, 6=MUMPS
$  NEGEV  : 0=stop, 1=warn, 2=allow negative eigenvalues
$  AUTOSPC: 1=auto single-point constraints for singular DOF
$
*CONTROL_IMPLICIT_SOLVER
$#  lsolvr    lprint     negev     order      drcm    drcprm   autospc   autotol
         2         0         2         0         4       0.0         1       0.0
$
$--- Implicit auto time stepping (for static preload) ---
$
*CONTROL_IMPLICIT_AUTO
$#   iauto    iteopt    itewin     dtmin     dtmax     dtexp     kfail    kcycle
         1        11         5       0.0       0.0       0.0         0         0
$
$--- Analysis termination ---
$
*CONTROL_TERMINATION
$#  endtim    endcyc     dtmin    endeng    endmas     nosol
       0.0         0       0.0       0.0  1.000E+8         0
$
$==========================================================================
$  OUTPUT CONTROL
$==========================================================================
$
$--- Binary plot output (d3plot + d3eigv) ---
$
*DATABASE_BINARY_D3PLOT
$#      dt      lcdt      beam     npltc    psetid
       0.0         0         0         0         0
$
$--- Binary output extent (what fields to include) ---
$
*DATABASE_EXTENT_BINARY
$#   neiph     neips    maxint    strflg    sigflg    epsflg    rltflg    engflg
         0         0         3         1         1         1         1         1
$#  cmpflg    ieverp    beamip     dcomp      shge     stssz    n3thdt   ialemat
         0         0         0         1         1         0         0         0
$# nintsld   pkp_sen      sclp    unused     msscl     therm    intout    nodout
         0         0    1.0000         0         0         0    STRESS    STRESS
$
$--- General output control ---
$
*CONTROL_OUTPUT
$#   npopt    netefq     nrefup    iaccop     optefq    ipnint    iketefq
         0         0         0         0       0.0         0         0
$
$==========================================================================
$  ADDITIONAL CONTROLS
$==========================================================================
$
$--- Energy computation (hourglass, stonewall, sliding, Rayleigh) ---
$
*CONTROL_ENERGY
$#    hgen      rwen    slnten     rylen
         2         2         2         2
$
$--- Hourglass control ---
$  IHQ: 6=Belytschko-Bindeman assumed strain (shells)
$  QH : Hourglass coefficient (default 0.10)
$
*CONTROL_HOURGLASS
$#     ihq        qh
         6   0.10000
$
$--- Accuracy / objectivity settings ---
$  OSU=1 : Objective stress update (2nd order accurate)
$  INN=4 : Invariant node numbering for shells + solids
$
*CONTROL_ACCURACY
$#     osu       inn    pidosu      iacc
         1         4         0         0
$
$--- Bulk viscosity (standard defaults) ---
$
*CONTROL_BULK_VISCOSITY
$#      q1        q2      type     btype
    1.5000   0.06000        -2         0
$
$--- Shell element control ---
$  WRPANG=20 : Shell warping angle limit
$  ESORT =1  : Auto-sort shell formulations for accuracy
$  ISTUPD=1  : Shell thickness update (large strain)
$  THEORY=2  : BWC (Belytschko-Wong-Chiang) shell theory
$
*CONTROL_SHELL
$#  wrpang    esort     irnxx    istupd    theory       bwc     miter      proj
   20.0000         1        -1         1         2         2         1         0
$
$--- Solid element control ---
$  ESORT=1 : Auto-sort solid formulations
$
*CONTROL_SOLID
$#   esort    fmatrx    niptets      swlocl    ptefct
         1         0         4         0         0
$
$==========================================================================
$  NOTE: Material (*MAT_), mesh (*ELEMENT_, *NODE), boundary conditions
$  (*BOUNDARY_SPC_), and load (*LOAD_) cards are in separate .k includes.
$==========================================================================
$


*END
