<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
    <!-- Version is injected at build time from the single source of truth (MSBuild
         property MXVersion, passed as -d Version=...). Defaults to 1.4.0 if built with a
         bare `wix build`. Bumping MXVersion in the .csproj naturally drives MajorUpgrade
         (an in-place upgrade that removes the old build before installing the new one). -->
    <?ifndef Version ?>
        <?define Version = "1.4.0" ?>
    <?endif?>
    <Package
        Name="MX Digital Twin Modeller"
        Manufacturer="MX Composites"
        Version="$(Version)"
        UpgradeCode="A7E3B5C1-4D2F-4A8E-9B1C-6F3D8E2A1B5C"
        Scope="perMachine"
        InstallerVersion="500"
        Compressed="yes">

        <MajorUpgrade
            DowngradeErrorMessage="A newer version of MX Digital Twin Modeller is already installed." />

        <MediaTemplate EmbedCab="yes" />

        <!-- ================================================================ -->
        <!-- Install UI (Welcome → License → InstallDir → Progress → Finish) -->
        <!-- ================================================================ -->

        <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

        <!-- ================================================================ -->
        <!-- Directory structure                                               -->
        <!-- ================================================================ -->

        <!-- SpaceClaim Add-In: C:\ProgramData\SpaceClaim\AddIns\MXDigitalTwinModeller\V252 -->
        <StandardDirectory Id="CommonAppDataFolder">
            <Directory Id="SpaceClaimDir" Name="SpaceClaim">
                <Directory Id="AddInsDir" Name="AddIns">
                    <Directory Id="MXDir" Name="MXDigitalTwinModeller">
                        <Directory Id="INSTALLFOLDER" Name="V252">
                            <!-- Claude Desktop MCP stdio bridge (ships beside the Add-In DLL). -->
                            <Directory Id="McpBridgeDir" Name="mcp_bridge" />
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>
        </StandardDirectory>

        <!-- Mechanical ACT Extension: %APPDATA%\Ansys\v252\ACT\extensions\MXSimulator -->
        <StandardDirectory Id="AppDataFolder">
            <Directory Id="AnsysDir" Name="Ansys">
                <Directory Id="V252Dir" Name="v252">
                    <Directory Id="ACTDir" Name="ACT">
                        <Directory Id="ExtensionsDir" Name="extensions">
                            <Directory Id="MECHANICALFOLDER" Name="MXSimulator">
                                <Directory Id="MechanicalBinDir"    Name="bin" />
                                <Directory Id="MechanicalImagesDir" Name="images" />
                                <Directory Id="PostProcessDir"      Name="postprocess" />
                                <Directory Id="CalibrationDir"      Name="calibration">
                                    <Directory Id="CalibrationUtilsDir" Name="utils" />
                                </Directory>
                            </Directory>
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>
        </StandardDirectory>

        <!-- ================================================================ -->
        <!-- SpaceClaim Add-In                                                 -->
        <!-- ================================================================ -->

        <ComponentGroup Id="SpaceClaimComponents" Directory="INSTALLFOLDER">
            <Component Id="MainDll" Guid="*">
                <File Id="MXDigitalTwinModeller.dll"
                      Source="$(BuildOutputDir)\MXDigitalTwinModeller.dll"
                      KeyPath="yes" />
            </Component>
            <Component Id="ManifestXml" Guid="*">
                <File Id="MXDigitalTwinModeller.Manifest.xml"
                      Source="$(BuildOutputDir)\MXDigitalTwinModeller.Manifest.xml"
                      KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!-- ================================================================ -->
        <!-- Claude Desktop MCP bridge (stdio<->loopback HTTP) + 1-click setup -->
        <!-- ================================================================ -->

        <ComponentGroup Id="McpBridgeComponents" Directory="McpBridgeDir">
            <!-- Python-free standalone EXEs (PyInstaller) — the primary artifacts the config
                 points at, so the end user needs NO Python installed. Built by build_bridge.bat. -->
            <Component Id="McpBridgeExe" Guid="*">
                <File Id="mxdtm_mcp_bridge.exe"
                      Source="$(ProjectDir)\tools\mcp_bridge\mxdtm_mcp_bridge.exe"
                      KeyPath="yes" />
            </Component>
            <Component Id="McpRegisterExe" Guid="*">
                <File Id="register_claude_desktop.exe"
                      Source="$(ProjectDir)\tools\mcp_bridge\register_claude_desktop.exe"
                      KeyPath="yes" />
            </Component>
            <!-- Python source + .bat + README (fallback for source runs / manual setup / docs). -->
            <Component Id="McpBridgePy" Guid="*">
                <File Id="mxdtm_mcp_bridge.py"
                      Source="$(ProjectDir)\tools\mcp_bridge\mxdtm_mcp_bridge.py"
                      KeyPath="yes" />
            </Component>
            <Component Id="McpRegisterPy" Guid="*">
                <File Id="register_claude_desktop.py"
                      Source="$(ProjectDir)\tools\mcp_bridge\register_claude_desktop.py"
                      KeyPath="yes" />
            </Component>
            <Component Id="McpRegisterBat" Guid="*">
                <File Id="register_claude_desktop.bat"
                      Source="$(ProjectDir)\tools\mcp_bridge\register_claude_desktop.bat"
                      KeyPath="yes" />
            </Component>
            <Component Id="McpBridgeReadme" Guid="*">
                <File Id="mcp_bridge_README.md" Name="README.md"
                      Source="$(ProjectDir)\tools\mcp_bridge\README.md"
                      KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!-- Install-time auto-registration with Claude Desktop.
             The registrar merges an 'mxdtm-spaceclaim' server into the INSTALLING USER's
             %APPDATA%\Claude config, so the CA must run IMPERSONATED (not as the elevated
             SYSTEM account whose %APPDATA% is the wrong profile). It is best-effort: a
             failure (e.g. no Claude Desktop yet) must NOT abort the install, so the sequence
             condition + the CA's own non-fatal exit handling keep setup succeeding. The user
             can always re-run register_claude_desktop.exe / .bat later. -->
        <CustomAction Id="RegisterClaudeDesktop"
                      FileRef="register_claude_desktop.exe"
                      ExeCommand=""
                      Execute="deferred"
                      Impersonate="yes"
                      Return="ignore" />
        <InstallExecuteSequence>
            <Custom Action="RegisterClaudeDesktop" After="InstallFiles"
                    Condition="NOT REMOVE" />
        </InstallExecuteSequence>

        <!-- ================================================================ -->
        <!-- Mechanical ACT Extension — XML                                    -->
        <!-- ================================================================ -->

        <!-- MXSimulator.xml goes in extensions root -->
        <ComponentGroup Id="MechanicalExtensionXml" Directory="ExtensionsDir">
            <Component Id="ExtensionXml" Guid="*">
                <File Id="MXSimulator.xml" Name="MXSimulator.xml"
                      Source="$(ProjectDir)\Mechanical\MXSimulator.xml"
                      KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!-- ================================================================ -->
        <!-- Mechanical ACT Extension — Python scripts                         -->
        <!-- ================================================================ -->

        <ComponentGroup Id="MechanicalComponents" Directory="MECHANICALFOLDER">
            <Component Id="MainPy" Guid="*">
                <File Id="main.py"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\main.py"
                      KeyPath="yes" />
            </Component>
            <Component Id="RunScript" Guid="*">
                <File Id="run_cap_vibration.py"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\run_cap_vibration.py"
                      KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!-- ================================================================ -->
        <!-- Icons                                                             -->
        <!-- ================================================================ -->

        <ComponentGroup Id="MechanicalImages" Directory="MechanicalImagesDir">
            <Component Id="CapVibrationIcon" Guid="*">
                <File Id="cap_vibration.png"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\images\cap_vibration.png"
                      KeyPath="yes" />
            </Component>
            <Component Id="ModalAnalysisIcon" Guid="*">
                <File Id="modal_analysis.png"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\images\modal_analysis.png"
                      KeyPath="yes" />
            </Component>
            <Component Id="AddScenarioIcon" Guid="*">
                <File Id="add_scenario.png"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\images\add_scenario.png"
                      KeyPath="yes" />
            </Component>
            <Component Id="FacePairIcon" Guid="*">
                <File Id="face_pair.png"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\images\face_pair.png"
                      KeyPath="yes" />
            </Component>
            <Component Id="PostProcessIcon" Guid="*">
                <File Id="post_process.png"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\images\post_process.png"
                      KeyPath="yes" />
            </Component>
            <Component Id="MaterialTwinIcon" Guid="*">
                <File Id="material_twin.png"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\images\material_twin.png"
                      KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!-- ================================================================ -->
        <!-- Shared DLL (Mechanical bin)                                       -->
        <!-- ================================================================ -->

        <ComponentGroup Id="MechanicalBin" Directory="MechanicalBinDir">
            <Component Id="SharedDll" Guid="*">
                <File Id="MXDigitalTwinModeller.Core.dll"
                      Source="$(ProjectDir)\bin\$(Configuration)\MXDigitalTwinModeller.Core.dll"
                      KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!-- ================================================================ -->
        <!-- Post-Process Viewer                                               -->
        <!--   MXPostViewer.exe must be pre-built:                            -->
        <!--     cd Mechanical\MXSimulator\postprocess                        -->
        <!--     build_viewer.bat                                              -->
        <!-- ================================================================ -->

        <ComponentGroup Id="PostProcessComponents" Directory="PostProcessDir">
            <!-- Standalone viewer (PyInstaller bundle) — primary launch target -->
            <Component Id="PostViewerExe" Guid="*">
                <File Id="MXPostViewer.exe"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\postprocess\MXPostViewer.exe"
                      KeyPath="yes" />
            </Component>

            <!-- Python source fallback -->
            <Component Id="RunnerPy" Guid="*">
                <File Id="runner.py"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\postprocess\runner.py"
                      KeyPath="yes" />
            </Component>
            <Component Id="AnalyzerPy" Guid="*">
                <File Id="analyzer.py"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\postprocess\analyzer.py"
                      KeyPath="yes" />
            </Component>
            <Component Id="VisualizerPy" Guid="*">
                <File Id="visualizer.py"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\postprocess\visualizer.py"
                      KeyPath="yes" />
            </Component>

            <!-- Setup helpers (for environments without the exe) -->
            <Component Id="RequirementsTxt" Guid="*">
                <File Id="requirements.txt"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\postprocess\requirements.txt"
                      KeyPath="yes" />
            </Component>
            <Component Id="SetupVenvBat" Guid="*">
                <File Id="setup_venv.bat"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\postprocess\setup_venv.bat"
                      KeyPath="yes" />
            </Component>
            <Component Id="BuildViewerBat" Guid="*">
                <File Id="build_viewer.bat"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\postprocess\build_viewer.bat"
                      KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!-- ================================================================ -->
        <!-- Material Twin Calibration Module                                  -->
        <!--   MaterialCalibrator.exe must be pre-built:                      -->
        <!--     cd Mechanical\MXSimulator\calibration                        -->
        <!--     build_calibrator.bat                                         -->
        <!-- ================================================================ -->

        <ComponentGroup Id="CalibrationComponents" Directory="CalibrationDir">
            <!-- Standalone calibrator (PyInstaller bundle) — primary -->
            <Component Id="MaterialCalibratorExe" Guid="*">
                <File Id="MaterialCalibrator.exe"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\calibration\MaterialCalibrator.exe"
                      KeyPath="yes" />
            </Component>

            <!-- Python source fallback -->
            <Component Id="CalibrationRunner" Guid="*">
                <File Id="calibration_runner.py" Name="runner.py"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\calibration\runner.py"
                      KeyPath="yes" />
            </Component>
            <Component Id="ElasticCalibrator" Guid="*">
                <File Id="elastic_calibrator.py"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\calibration\elastic_calibrator.py"
                      KeyPath="yes" />
            </Component>

            <!-- Setup helpers (from parent MXSimulator folder) -->
            <Component Id="CalibrationRequirements" Guid="*">
                <File Id="calibration_requirements.txt" Name="requirements.txt"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\requirements.txt"
                      KeyPath="yes" />
            </Component>
            <Component Id="CalibrationSetupVenv" Guid="*">
                <File Id="calibration_setup_venv.bat" Name="setup_venv.bat"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\setup_venv.bat"
                      KeyPath="yes" />
            </Component>
            <Component Id="CalibrationInit" Guid="*">
                <File Id="calibration_init.py" Name="__init__.py"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\calibration\__init__.py"
                      KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <ComponentGroup Id="CalibrationUtils" Directory="CalibrationUtilsDir">
            <Component Id="YamlParser" Guid="*">
                <File Id="yaml_parser.py"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\calibration\utils\yaml_parser.py"
                      KeyPath="yes" />
            </Component>
            <Component Id="CsvParser" Guid="*">
                <File Id="csv_parser.py"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\calibration\utils\csv_parser.py"
                      KeyPath="yes" />
            </Component>
            <Component Id="UtilsInit" Guid="*">
                <File Id="calibration_utils_init.py" Name="__init__.py"
                      Source="$(ProjectDir)\Mechanical\MXSimulator\calibration\utils\__init__.py"
                      KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!-- ================================================================ -->
        <!-- Features                                                          -->
        <!-- ================================================================ -->

        <Feature Id="SpaceClaimFeature" Title="SpaceClaim Add-In" Level="1"
                 Description="SpaceClaim Add-In for composite specimen modeling">
            <ComponentGroupRef Id="SpaceClaimComponents" />
            <ComponentGroupRef Id="McpBridgeComponents" />
        </Feature>

        <Feature Id="MechanicalFeature" Title="Mechanical ACT Extension" Level="1"
                 Description="ANSYS Mechanical ACT Extension for simulation and Material Twin">
            <ComponentGroupRef Id="MechanicalExtensionXml" />
            <ComponentGroupRef Id="MechanicalComponents" />
            <ComponentGroupRef Id="MechanicalImages" />
            <ComponentGroupRef Id="MechanicalBin" />
            <Feature Id="PostProcessFeature" Title="Post-Process Viewer" Level="1"
                     Description="Standalone PyQt5 viewer for FFT / FRF post-processing (MXPostViewer.exe)">
                <ComponentGroupRef Id="PostProcessComponents" />
            </Feature>
            <Feature Id="MaterialTwinFeature" Title="Material Twin Calibration" Level="1"
                     Description="Material property calibration from experimental data (MaterialCalibrator.exe)">
                <ComponentGroupRef Id="CalibrationComponents" />
                <ComponentGroupRef Id="CalibrationUtils" />
            </Feature>
        </Feature>

    </Package>
</Wix>
