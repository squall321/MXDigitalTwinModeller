# /etc/mxdpf.env (systemd EnvironmentFile) — 값에 따옴표 쓰지 않음
MXDPF_HOST=0.0.0.0
MXDPF_PORT=8770
MXDPF_TOKEN=change-me-long-random
MXDPF_WORK_DIR=/var/lib/mxdpf/jobs
MXDPF_MAX_CONCURRENCY=1
MXDPF_JOB_TIMEOUT_SEC=1800
MXDPF_MAX_UPLOAD_MB=4096
MXDPF_JOB_TTL_HOURS=72
MXDPF_ALLOWED_ROOTS=/mnt/cae
AWP_ROOT252=/ansys_inc/v252
ANSYSLMD_LICENSE_FILE=1055@license-server
