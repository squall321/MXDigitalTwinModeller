  <!--
    ================================================================
    Deploy Mechanical ACT Extension after build
    ================================================================
    BUILD_PIPELINE_PLAN.md Phase B 적용:
    - calibration/ 전체 (Python + utils/ + EXE) 복사
    - 누락 아이콘 3개 (tied_check, material_twin, kfile_export) 추가
    - Shared DLL 을 SpaceClaim V252\ 폴더에도 복사
    - Ribbon cache 자동 클리어 (별도 Target)
  -->
  <Target Name="DeployMechanicalExtension" AfterTargets="Build">
    <PropertyGroup>
      <MechanicalExtDir>$(APPDATA)\ANSYS\v252\ACT\extensions\MXSimulator</MechanicalExtDir>
      <MechanicalExtParent>$(APPDATA)\ANSYS\v252\ACT\extensions</MechanicalExtParent>
      <SharedDllProject>$(ProjectDir)Shared\MXDigitalTwinModeller.Core\MXDigitalTwinModeller.Core.csproj</SharedDllProject>
      <SharedDllSource>$(ProjectDir)bin\$(Configuration)\MXDigitalTwinModeller.Core.dll</SharedDllSource>
      <SpaceClaimAddInDir>$(OutputPath)</SpaceClaimAddInDir>
    </PropertyGroup>

    <!-- Build Shared DLL first -->
    <Message Text="Building Shared DLL: $(SharedDllProject)" Importance="high" />
    <MSBuild Projects="$(SharedDllProject)"
             Properties="Configuration=$(Configuration);Platform=AnyCPU"
             Condition="Exists('$(SharedDllProject)')" />

    <!-- Create target directories -->
    <MakeDir Directories="$(MechanicalExtDir)" Condition="!Exists('$(MechanicalExtDir)')" />
    <MakeDir Directories="$(MechanicalExtDir)\bin" Condition="!Exists('$(MechanicalExtDir)\bin')" />
    <MakeDir Directories="$(MechanicalExtDir)\images" Condition="!Exists('$(MechanicalExtDir)\images')" />
    <MakeDir Directories="$(MechanicalExtDir)\postprocess" Condition="!Exists('$(MechanicalExtDir)\postprocess')" />
    <MakeDir Directories="$(MechanicalExtDir)\calibration" Condition="!Exists('$(MechanicalExtDir)\calibration')" />
    <MakeDir Directories="$(MechanicalExtDir)\calibration\utils" Condition="!Exists('$(MechanicalExtDir)\calibration\utils')" />

    <!-- Copy MXSimulator.xml to extensions parent -->
    <Copy SourceFiles="$(ProjectDir)Mechanical\MXSimulator.xml"
          DestinationFiles="$(MechanicalExtParent)\MXSimulator.xml"
          SkipUnchangedFiles="true" />

    <!-- Copy main Python script + run_cap_vibration + venv setup -->
    <Copy SourceFiles="$(ProjectDir)Mechanical\MXSimulator\main.py;
                       $(ProjectDir)Mechanical\MXSimulator\run_cap_vibration.py;
                       $(ProjectDir)Mechanical\MXSimulator\setup_venv.bat;
                       $(ProjectDir)Mechanical\MXSimulator\requirements.txt"
          DestinationFolder="$(MechanicalExtDir)"
          SkipUnchangedFiles="true" />

    <!-- Copy all 8 icons (was 5; added tied_check, material_twin, kfile_export) -->
    <Copy SourceFiles="$(ProjectDir)Mechanical\MXSimulator\images\cap_vibration.png;
                       $(ProjectDir)Mechanical\MXSimulator\images\modal_analysis.png;
                       $(ProjectDir)Mechanical\MXSimulator\images\add_scenario.png;
                       $(ProjectDir)Mechanical\MXSimulator\images\face_pair.png;
                       $(ProjectDir)Mechanical\MXSimulator\images\post_process.png;
                       $(ProjectDir)Mechanical\MXSimulator\images\tied_check.png;
                       $(ProjectDir)Mechanical\MXSimulator\images\material_twin.png;
                       $(ProjectDir)Mechanical\MXSimulator\images\kfile_export.png"
          DestinationFolder="$(MechanicalExtDir)\images"
          SkipUnchangedFiles="true" />

    <!-- Copy postprocess (Python source + EXE if built) -->
    <Copy SourceFiles="$(ProjectDir)Mechanical\MXSimulator\postprocess\runner.py;
                       $(ProjectDir)Mechanical\MXSimulator\postprocess\analyzer.py;
                       $(ProjectDir)Mechanical\MXSimulator\postprocess\visualizer.py;
                       $(ProjectDir)Mechanical\MXSimulator\postprocess\requirements.txt;
                       $(ProjectDir)Mechanical\MXSimulator\postprocess\setup_venv.bat;
                       $(ProjectDir)Mechanical\MXSimulator\postprocess\build_viewer.bat"
          DestinationFolder="$(MechanicalExtDir)\postprocess"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Mechanical\MXSimulator\postprocess\MXPostViewer.exe"
          DestinationFolder="$(MechanicalExtDir)\postprocess"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)Mechanical\MXSimulator\postprocess\MXPostViewer.exe')" />
    <Message Text="WARNING: MXPostViewer.exe not found - Post-Process viewer will use Python fallback"
             Importance="high"
             Condition="!Exists('$(ProjectDir)Mechanical\MXSimulator\postprocess\MXPostViewer.exe')" />

    <!-- Copy calibration (Python module + utils + EXE if built) -->
    <Copy SourceFiles="$(ProjectDir)Mechanical\MXSimulator\calibration\__init__.py;
                       $(ProjectDir)Mechanical\MXSimulator\calibration\runner.py;
                       $(ProjectDir)Mechanical\MXSimulator\calibration\elastic_calibrator.py;
                       $(ProjectDir)Mechanical\MXSimulator\calibration\run_elastic_calibration.py"
          DestinationFolder="$(MechanicalExtDir)\calibration"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Mechanical\MXSimulator\calibration\utils\__init__.py;
                       $(ProjectDir)Mechanical\MXSimulator\calibration\utils\csv_parser.py;
                       $(ProjectDir)Mechanical\MXSimulator\calibration\utils\yaml_parser.py"
          DestinationFolder="$(MechanicalExtDir)\calibration\utils"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Mechanical\MXSimulator\calibration\MaterialCalibrator.exe"
          DestinationFolder="$(MechanicalExtDir)\calibration"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)Mechanical\MXSimulator\calibration\MaterialCalibrator.exe')" />
    <Message Text="WARNING: MaterialCalibrator.exe not found - Material Twin will use Python fallback"
             Importance="high"
             Condition="!Exists('$(ProjectDir)Mechanical\MXSimulator\calibration\MaterialCalibrator.exe')" />

    <!-- Copy Shared DLL to Mechanical extension bin folder -->
    <Copy SourceFiles="$(SharedDllSource)"
          DestinationFolder="$(MechanicalExtDir)\bin"
          SkipUnchangedFiles="true"
          Condition="Exists('$(SharedDllSource)')" />

    <!-- Copy Shared DLL to SpaceClaim Add-In folder (V252\) — for SpaceClaim 측 참조 -->
    <Copy SourceFiles="$(SharedDllSource)"
          DestinationFolder="$(SpaceClaimAddInDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(SharedDllSource)')" />

    <Message Text="Mechanical ACT Extension deployed to: $(MechanicalExtDir)" Importance="high" />
    <Message Text="Shared DLL deployed: -&gt; $(MechanicalExtDir)\bin\ AND $(SpaceClaimAddInDir)" Importance="high" Condition="Exists('$(SharedDllSource)')" />
  </Target>

  <!--
    ================================================================
    Clear Workbench Ribbon Cache after deploy
    ================================================================
    캐시 stale 로 새 버튼/아이콘 인식 안 되는 문제 방지.
    매 빌드마다 실행 (BUILD_PIPELINE_PLAN.md 결정 5.2).
  -->
  <Target Name="ClearWorkbenchRibbonCache" AfterTargets="DeployMechanicalExtension">
    <PropertyGroup>
      <RibbonCacheDir>$(APPDATA)\Ansys\v252\Applets\DSApplet\en-us</RibbonCacheDir>
    </PropertyGroup>
    <Delete Files="$(RibbonCacheDir)\ExternalActions.xml;
                   $(RibbonCacheDir)\ribbonLayout.xml;
                   $(RibbonCacheDir)\RibbonState.xml"
            ContinueOnError="true" />
    <Message Text="Workbench ribbon cache cleared: $(RibbonCacheDir)" Importance="high" />
  </Target>

  <!--
    ================================================================
    Build MSI installer after main build
    ================================================================
    PyInstaller EXE 미존재 시 wix build 실패 가능 →
    EXE 존재 확인 후 분기 (BUILD_PIPELINE_PLAN.md Phase B-5).
  -->
  <Target Name="BuildInstaller" AfterTargets="ClearWorkbenchRibbonCache">
    <PropertyGroup>
      <CalibratorExeExists Condition="Exists('$(ProjectDir)Mechanical\MXSimulator\calibration\MaterialCalibrator.exe')">true</CalibratorExeExists>
      <CalibratorExeExists Condition="!Exists('$(ProjectDir)Mechanical\MXSimulator\calibration\MaterialCalibrator.exe')">false</CalibratorExeExists>
      <ViewerExeExists Condition="Exists('$(ProjectDir)Mechanical\MXSimulator\postprocess\MXPostViewer.exe')">true</ViewerExeExists>
      <ViewerExeExists Condition="!Exists('$(ProjectDir)Mechanical\MXSimulator\postprocess\MXPostViewer.exe')">false</ViewerExeExists>
      <CanBuildMsi>false</CanBuildMsi>
      <CanBuildMsi Condition="'$(CalibratorExeExists)' == 'true' AND '$(ViewerExeExists)' == 'true'">true</CanBuildMsi>
    </PropertyGroup>

    <Message Text="MSI build skipped: PyInstaller EXE(s) missing. Run build.ps1 (or build_calibrator.bat / build_viewer.bat) to build them first."
             Importance="high"
             Condition="'$(CanBuildMsi)' != 'true'" />
    <Message Text="  - MaterialCalibrator.exe: $(CalibratorExeExists)"
             Importance="high"
             Condition="'$(CanBuildMsi)' != 'true'" />
    <Message Text="  - MXPostViewer.exe: $(ViewerExeExists)"
             Importance="high"
             Condition="'$(CanBuildMsi)' != 'true'" />

    <Exec Command="wix build &quot;$(ProjectDir)Installer\MXDigitalTwinModeller.wxs&quot; -d BuildOutputDir=&quot;$(OutputPath.TrimEnd('\\'))&quot; -d ProjectDir=&quot;$(ProjectDir.TrimEnd('\\'))&quot; -d Configuration=$(Configuration) -ext WixToolset.UI.wixext -o &quot;$(ProjectDir)Installer\MXDigitalTwinModeller.msi&quot; -arch x64 --nologo"
          IgnoreExitCode="false"
          Condition="'$(CanBuildMsi)' == 'true'" />
    <Message Text="MSI installer built: $(ProjectDir)Installer\MXDigitalTwinModeller.msi"
             Importance="high"
             Condition="'$(CanBuildMsi)' == 'true'" />
  </Target>
</Project>
