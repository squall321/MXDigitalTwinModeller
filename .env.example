# SpaceClaim 경로 설정 (v252 전용)
# 실제 사용 시 .env.example을 .env로 복사하여 사용하세요.
# 대부분 Directory.Build.props의 기본 경로로 충분하므로 .env 없이도 빌드됩니다.

# Visual Studio 2022 MSBuild 경로
# Community Edition 예시
MSBUILD_PATH=C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Current\Bin\MSBuild.exe
# Professional Edition 예시
# MSBUILD_PATH=C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Current\Bin\MSBuild.exe
# Enterprise Edition 예시
# MSBUILD_PATH=C:\Program Files\Microsoft Visual Studio\2022\Enterprise\MSBuild\Current\Bin\MSBuild.exe

# SpaceClaim V252 경로
SPACECLAIM_V252_INSTALL_PATH=C:\Program Files\ANSYS Inc\v252\SpaceClaim
SPACECLAIM_V252_API_PATH=C:\Program Files\ANSYS Inc\v252\SpaceClaim\Api\V252\bin\x64\Debug
SPACECLAIM_V252_EXE=C:\Program Files\ANSYS Inc\v252\SpaceClaim\SpaceClaim.exe

# AddIn 출력 경로
ADDIN_OUTPUT_PATH_V252=C:\ProgramData\SpaceClaim\AddIns\MXDigitalTwinModeller\V252
